# Passphrase to gate the /downloads?stats page.
# Set this in Netlify environment variables (not in source control).
# If unset (local dev), the stats page is accessible without a password.
VITE_STATS_PASSWORD=your-secret-passphrase-here

# GitHub personal access token for fetching release/download counts
VITE_GH_TOKEN=

# LemonSqueezy API key (for Netlify functions)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# GitHub token for Netlify functions
FIBERTUNER_SITE_TOKEN=
